{
  "browser_screen": {
    "enabled": true,
    "fill_content_area": true,
    "preload_on_start": true,
    "show_on_start": false,
    "external_links": false,
    "allow_new_windows": false,
    "margin": 8,
    "default_url": "https://app.roll20.net/login",
    "show_url_bar": false,
    "url_bar_h": 36,
    "gap": 0,
    "inner_margin": 0,
    "background": "transparent",
    "border_color": "transparent",
    "reload_button_size": 24,
    "reload_button_margin": 8,
    "reload_button_asset": "ui_elements/icons/checkmark_true.png",
    "reload_button_text_color": "#e8e0c8",
    "debug": {
      "enabled": false,
      "console_messages": false,
      "navigation": false,
      "suppress_engine_noise": true,
      "persistence_test_enabled": false,
      "persistence_test_url_keyword": "persistence-test"
    },
    "profile": {
      "enabled": true,
      "name": "roll20",
      "use_default_profile": true,
      "persistent_cookies": true,
      "force_persistent_cookies": true,
      "cache_enabled": true,
      "disk_cache": true,
      "http_cache_maximum_size": 0,
      "storage_subdir": "browser_profiles/roll20_default",
      "encrypt_at_rest": false,
      "cookie_backup": {
        "enabled": true,
        "file": "browser_profiles/roll20_cookie_backup.json",
        "domains": [
          "roll20.net",
          ".roll20.net",
          "app.roll20.net"
        ]
      }
    }
  }
}
